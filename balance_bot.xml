<mujoco model="balance_bot">
    <compiler angle="degree"/>
    <option timestep="0.01" gravity="0 0 -9.81"/>

    <worldbody>
        <!-- Floor -->
        <geom type="plane" size="5 5 0.1" rgba=".9 .9 .9 1"/>
        <light pos="0 0 2"/>

        <!-- Robot Chassis -->
        <body name="chassis" pos="0 0 0.1">
            <freejoint/> <!-- Allow robot to fall and move in the world -->
            <geom type="box" size="0.05 0.05 0.1" rgba="0.2 0.6 0.8 1" mass="0.5"/>
            
            <!-- IMU Sensor Location -->
            <site name="imu_site" pos="0 0 0.05"/>

            <!-- Left Wheel -->
            <body name="left_wheel" pos="0 0.07 -0.05">
                <joint name="left_motor_joint" type="hinge" axis="0 1 0"/>
                <geom type="cylinder" size="0.04 0.01" rgba="0.1 0.1 0.1 1" mass="0.1" euler="90 0 0"/>
            </body>

            <!-- Right Wheel -->
            <body name="right_wheel" pos="0 -0.07 -0.05">
                <joint name="right_motor_joint" type="hinge" axis="0 1 0"/>
                <geom type="cylinder" size="0.04 0.01" rgba="0.1 0.1 0.1 1" mass="0.1" euler="90 0 0"/>
            </body>
        </body>
    </worldbody>

    <!-- Map motors to the wheel joints -->
    <actuator>
        <motor name="left_motor" joint="left_motor_joint" gear="1" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_motor" joint="right_motor_joint" gear="1" ctrllimited="true" ctrlrange="-1 1"/>
    </actuator>

    <!-- Read gyroscope and accelerometer data from the chassis -->
    <sensor>
        <gyro name="gyro" site="imu_site"/>
        <accelerometer name="accel" site="imu_site"/>
    </sensor>
</mujoco>